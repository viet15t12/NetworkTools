! === CẤU HÌNH STANDARD ACL CẢI TIẾN ===
{% if action == 'delete' %}
no ip access-list standard {{ acl_name }}
{% else %}
ip access-list standard {{ acl_name }}

{% if push_desc and description %}
remark {{ description }}
{% elif push_desc == False and description %}
no remark {{ description }}
{% endif %}

{% for rule in rules_del %}
no {{ rule.seq }}
{% endfor %}

{% for rule in rules_add %}
{# -- Render đúng những gì có trong DB, không tự thêm thắt -- #}
{{ rule.seq }} {{ rule.action }} {{ rule.src }}{{ ' ' + rule.src_mask if rule.src_mask else '' }}
{% endfor %}
exit
{% endif %}