! ==============================================================
! 1. CẤU HÌNH GLOBAL L2 SECURITY (DHCP SNOOPING & DAI THEO VLAN)
! ==============================================================
{% if global_sec | selectattr("dhcp_snooping", "equalto", 1) | list | length > 0 %}
ip dhcp snooping
{% endif %}

{% for sec in global_sec %}
{% if sec.dhcp_snooping == 1 %}
ip dhcp snooping vlan {{ sec.vlan_id }}
{% else %}
no ip dhcp snooping vlan {{ sec.vlan_id }}
{% endif %}

{% if sec.dai_enabled == 1 %}
ip arp inspection vlan {{ sec.vlan_id }}
{% else %}
no ip arp inspection vlan {{ sec.vlan_id }}
{% endif %}
{% endfor %}

! ==============================================================
! 2. CẤU HÌNH BẢO MẬT TRÊN TỪNG INTERFACE (TRUST & PORT SEC)
! ==============================================================
{% for iface in interfaces %}
interface {{ iface.if_name }}

 ! --- Cấu hình Trust ---
 {% if iface.is_trusted == 1 %}
 ip dhcp snooping trust
 ip arp inspection trust
 {% else %}
 no ip dhcp snooping trust
 no ip arp inspection trust
 {% endif %}

 ! --- Cấu hình Port Security ---
 {% if iface.max_mac is not none %}
 switchport port-security
 switchport port-security maximum {{ iface.max_mac }}
 switchport port-security violation {{ iface.violation }}
 
 {% if iface.sticky == 1 %}
 switchport port-security mac-address sticky
 {% else %}
 no switchport port-security mac-address sticky
 {% endif %}
 
 {% if iface.aging_time is defined and iface.aging_time > 0 %}
 switchport port-security aging time {{ iface.aging_time }}
 switchport port-security aging type {{ iface.aging_type }}
 {% endif %}

 ! --- Vá MAC cố định dưới cổng Port Security (CHỈ NHẬN 'secure') ---
 {% for mac in iface.static_macs %}
 {% if mac.mac_type == 'secure' %}
 switchport port-security mac-address {{ mac.mac_addr }}
 {% endif %}
 {% endfor %}

 {% else %}
 ! --- Tắt Port Security nếu cổng không đăng ký max_mac ---
 no switchport port-security
 {% endif %}
 
 exit
{% endfor %}

! ==============================================================
! 3. CẤU HÌNH GẮN CHẶT MAC TĨNH (CHẠY ĐỘC LẬP TOÀN CỤC)
! ==============================================================
{% for iface in interfaces %}
{% for mac in iface.static_macs %}
{% if mac.mac_type == 'static' %}
mac address-table static {{ mac.mac_addr }} vlan {{ mac.vlan_id }} interface {{ iface.if_name }}
{% endif %}
{% endfor %}
{% endfor %}