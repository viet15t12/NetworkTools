! --- BGP SMART REMOVE ---
{# 1. Nếu CHỈ có local_as (không truyền neighbor, network...) -> Xóa sạch toàn bộ tiến trình BGP #}
{% if config.local_as and not config.neighbors and not config.networks and not config.route_maps and not config.prefix_lists %}
no router bgp {{ config.local_as }}
{% endif %}

{# 2. Nếu truyền đích danh Neighbors -> Chỉ xóa đúng láng giềng đó #}
{% if config.local_as and config.neighbors %}
router bgp {{ config.local_as }}
 {% for nbr in config.neighbors %}
 no neighbor {{ nbr.ip }}
 {% endfor %}
{% endif %}

{# 3. Nếu truyền đích danh Networks -> Rút đường mạng đó khỏi BGP #}
{% if config.local_as and config.networks %}
router bgp {{ config.local_as }}
 address-family ipv4
 {% for net in config.networks %}
 no network {{ net.ip }} {% if net.mask %}mask {{ net.mask }}{% endif %}
 {% endfor %}
 exit-address-family
{% endif %}

{# 4. Xóa các Policy (Route-map / Prefix-list) cụ thể #}
{% if config.route_maps %}
 {% for rm in config.route_maps %}
no route-map {{ rm.name }} {% if rm.seq %}{{ rm.action | default('permit') }} {{ rm.seq }}{% endif %}
 {% endfor %}
{% endif %}

{% if config.prefix_lists %}
 {% for pl in config.prefix_lists %}
no ip prefix-list {{ pl.name }} {% if pl.seq %}seq {{ pl.seq }}{% endif %}
 {% endfor %}
{% endif %}