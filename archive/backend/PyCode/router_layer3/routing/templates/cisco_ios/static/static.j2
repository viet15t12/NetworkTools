{# ==============================================================
   KIẾN TRÚC STATIC ROUTING UNIFIED TEMPLATE (MASTER VERSION)
   Xử lý: Default, Static IPv4/IPv6, Advanced (Track/BFD), VRF
   ============================================================== #}

{# 1. XỬ LÝ DEFAULT ROUTES (0.0.0.0 0.0.0.0) #}
{% if config.default_routes %}
    {% for route in config.default_routes %}
{{ 'no ' if route.state == 'remove' else '' }}ip route 0.0.0.0 0.0.0.0 {{ route.next_hop }}
    {% endfor %}
{% endif %}

{# 2. XỬ LÝ STATIC ROUTES BÌNH THƯỜNG (IPv4) #}
{% if config.static_routes %}
    {% for route in config.static_routes %}
        {% set prefix = 'no ' if route.state == 'remove' else '' %}
        
        {# Logic chọn Next-hop hoặc Interface #}
        {% set target = '' %}
        {% if route.interface and route.next_hop %}
            {% set target = route.interface ~ ' ' ~ route.next_hop %}
        {% elif route.interface %}
            {% set target = route.interface %}
        {% else %}
            {% set target = route.next_hop %}
        {% endif %}

        {# Tự động map subnet_mask/mask và ad/distance, kèm Tag/Track #}
{{ prefix }}ip route {{ route.network }} {{ route.subnet_mask | default(route.mask) }} {{ target }}{% if route.ad %} {{ route.ad }}{% elif route.distance %} {{ route.distance }}{% endif %}{% if route.tag %} tag {{ route.tag }}{% endif %}{% if route.track_id %} track {{ route.track_id }}{% endif %}
    {% endfor %}
{% endif %}

{# 3. XỬ LÝ ADVANCED STATIC ROUTES (BFD, TRACK CHUYÊN SÂU) #}
{% if config.advanced_static %}
    {% for route in config.advanced_static %}
{{ 'no ' if route.state == 'remove' else '' }}ip route {{ route.network }} {{ route.mask }} {{ route.next_hop }}{% if route.track_id %} track {{ route.track_id }}{% endif %}{% if route.bfd %} bfd{% endif %}
    {% endfor %}
{% endif %}

{# 4. XỬ LÝ VRF STATIC ROUTES #}
{% if config.vrf_static %}
    {% for vrf_item in config.vrf_static %}
        {% for route in vrf_item.routes %}
{{ 'no ' if route.state == 'remove' else '' }}ip route vrf {{ vrf_item.name }} {{ route.network }} {{ route.mask }} {{ route.next_hop }}
        {% endfor %}
    {% endfor %}
{% endif %}

{# 5. XỬ LÝ IPV6 STATIC ROUTES #}
{% if config.ipv6_static %}
    {% for route in config.ipv6_static %}
{{ 'no ' if route.state == 'remove' else '' }}ipv6 route {{ route.prefix }}{% if route.interface %} {{ route.interface }}{% endif %}{% if route.next_hop %} {{ route.next_hop }}{% endif %}
    {% endfor %}
{% endif %}