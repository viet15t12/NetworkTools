Cấp cố định ip cho 1 thiết bị duy nhất theo địa chỉ mac
[
  {
    "module": "dhcp",
    "action": "setup",
    "target": { "ip": "192.168.121.13" },
    "config": [
      {
        "static_bindings": [
          {
            "pool_name": "VIP_GIAMDOC",
            "state": "setup",
            "host_ip": "10.2.1.99",
            "subnet_mask": "255.255.255.0",
            "mac_address": "0100.5079.6668.0b", 
            "client_name": "GiamDoc_PC"
          }
        ]
      }
    ]
  }
]
