Tạo pool và excluded ip
[
  {
    "module": "dhcp",
    "action": "setup",
    "target": { "ip": "192.168.121.13" },
    "config": [
      {
        "excluded_addresses": [
          { "start_ip": "10.2.1.1", "end_ip": "10.2.1.10", "state": "setup" },
          { "start_ip": "10.2.2.1", "end_ip": "10.2.2.10", "state": "setup" }
        ],
        "pools": [
          {
            "name": "POOL_VPC7",
            "state": "setup",
            "network": "10.2.1.0",
            "subnet_mask": "255.255.255.0",
            "default_gateway": "10.2.1.1",
            "dns_server": "8.8.8.8",
            "domain_name": "right.lab"
          },
          {
            "name": "POOL_VPC8",
            "state": "setup",
            "network": "10.2.2.0",
            "subnet_mask": "255.255.255.0",
            "default_gateway": "10.2.2.1",
            "dns_server": "8.8.8.8",
            "domain_name": "right.lab"
          }
        ]
      }
    ]
  }
]
