            "domain_name": "lab.local",
            "lease": { "days": 36, "hours": 18, "minutes": 4 }
          }
        ]
      }
    ]
  }
]
=========================================================================================================
Dhcp snooping và trusted interface(Làm trên switch CHƯA TEST)
[
  {
    "module": "dhcp",
    "action": "setup",
    "target": { "ip": "192.168.121.14" },
    "config": [
      {
        "snooping": {
          "state": "setup",
          "vlans": "10,20,30",
          "trusted_interfaces": ["GigabitEthernet0/0", "GigabitEthernet0/1"]
        }
      }
    ]
  }
]
