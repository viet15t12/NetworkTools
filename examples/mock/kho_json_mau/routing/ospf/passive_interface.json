BẬT PASSIVE TRÊN TỪNG CỔNG
[
    {
        "module": "routing",
        "sub_type": "ospf",
        "action": "setup",
        "target": { "ip": "192.168.121.11" },
        "config": [{
            "process_id": 1,
            "router_id": "1.1.1.1",
            "passive_interfaces": [
                { "name": "GigabitEthernet0/3", "passive": true }
            ]
        }]
    },
    {
        "module": "routing",
        "sub_type": "ospf",
        "action": "setup",
        "target": { "ip": "192.168.121.17" },
        "config": [{
            "process_id": 1,
            "router_id": "7.7.7.7",
            "passive_interfaces": [
                { "name": "GigabitEthernet3", "passive": true }
            ]
        }]
    }
]

