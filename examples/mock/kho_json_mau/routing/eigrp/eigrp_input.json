        "target": { "ip": "192.168.121.105", "name": "vIOS5_Core_Variance" },
        "routing": { "type": "eigrp", "mode": "setup" },
        "config": {
            "local_as": 100,
            "variance": 2,
            "maximum_paths": 6
        }
    }
]







