{# Cisco IOS FHRP member configuration. Each task owns exactly one interface. #}
interface {{ config.interface_name }}
 {% if mode == 'remove' %}
{% if config.protocol == 'hsrp' %}
 no standby {{ config.group_number }} ip {{ config.virtual_ip }}
{% for track in config.tracks %}
 no standby {{ config.group_number }} track {{ track.track_object }}
{% endfor %}
{% if config.shutdown %}
 no standby {{ config.group_number }} shutdown
{% endif %}
{% if config.options.auth_type != 'none' %}
 no standby {{ config.group_number }} authentication
{% endif %}
{% if config.options.hello_ms != 3000 or config.options.hold_ms != 10000 %}
 no standby {{ config.group_number }} timers
{% endif %}
 no standby {{ config.group_number }} priority
{% if config.preempt %}
 no standby {{ config.group_number }} preempt
{% endif %}
{% elif config.protocol == 'vrrp' %}
 no vrrp {{ config.group_number }} ip {{ config.virtual_ip }}
{% for track in config.tracks %}
 no vrrp {{ config.group_number }} track {{ track.track_object }}
{% endfor %}
{% if config.shutdown %}
 no vrrp {{ config.group_number }} shutdown
{% endif %}
{% if config.options.auth_type != 'none' %}
 no vrrp {{ config.group_number }} authentication
{% endif %}
{% if config.options.advertisement_ms != 1000 %}
 no vrrp {{ config.group_number }} timers advertise
{% endif %}
 no vrrp {{ config.group_number }} priority
{% if config.preempt %}
 no vrrp {{ config.group_number }} preempt
{% endif %}
{% else %}
 no glbp {{ config.group_number }} ip {{ config.virtual_ip }}
{% for track in config.tracks %}
 no glbp {{ config.group_number }} weighting track {{ track.track_object }}
{% endfor %}
{% if config.shutdown %}
 no glbp {{ config.group_number }} shutdown
{% endif %}
{% if config.options.auth_type != 'none' %}
 no glbp {{ config.group_number }} authentication
{% endif %}
 no glbp {{ config.group_number }} forwarder preempt
 no glbp {{ config.group_number }} weighting
 no glbp {{ config.group_number }} load-balancing
{% if config.options.hello_ms != 3000 or config.options.hold_ms != 10000 %}
 no glbp {{ config.group_number }} timers
{% endif %}
 no glbp {{ config.group_number }} priority
 no glbp {{ config.group_number }} preempt
{% endif %}
{% else %}
{% set options = config.options %}
{% if config.protocol == 'hsrp' %}
 standby version {{ options.version }}
 standby {{ config.group_number }} ip {{ config.virtual_ip }}
 standby {{ config.group_number }} priority {{ config.priority }}
{% if config.preempt %}
 standby {{ config.group_number }} preempt{% if options.get('preempt_delay_min_sec', 0) or options.get('preempt_delay_reload_sec', 0) %} delay{% if options.get('preempt_delay_min_sec', 0) %} minimum {{ options.preempt_delay_min_sec }}{% endif %}{% if options.get('preempt_delay_reload_sec', 0) %} reload {{ options.preempt_delay_reload_sec }}{% endif %}{% endif %}
{% else %}
 no standby {{ config.group_number }} preempt
{% endif %}
{% if options.hello_ms != 3000 or options.hold_ms != 10000 %}
{% if options.hello_ms % 1000 == 0 and options.hold_ms % 1000 == 0 %}
 standby {{ config.group_number }} timers {{ options.hello_ms // 1000 }} {{ options.hold_ms // 1000 }}
{% else %}
 standby {{ config.group_number }} timers msec {{ options.hello_ms }} msec {{ options.hold_ms }}
{% endif %}
{% endif %}
{% if options.auth_type == 'plain' %}
 standby {{ config.group_number }} authentication {{ options.auth_secret }}
{% elif options.auth_type == 'md5-key' %}
 standby {{ config.group_number }} authentication md5 key-string {{ options.auth_secret }}
{% elif options.auth_type == 'md5-keychain' %}
 standby {{ config.group_number }} authentication md5 key-chain {{ options.auth_secret }}
{% endif %}
{% if config.shutdown %}
 standby {{ config.group_number }} shutdown
{% endif %}
{% for track in config.tracks %}
 standby {{ config.group_number }} track {{ track.track_object }} {{ track.decrement_value }}
{% endfor %}
{% elif config.protocol == 'vrrp' %}
 vrrp {{ config.group_number }} ip {{ config.virtual_ip }}
 vrrp {{ config.group_number }} priority {{ config.priority }}
{% if config.preempt %}
 vrrp {{ config.group_number }} preempt
{% else %}
 no vrrp {{ config.group_number }} preempt
{% endif %}
{% if options.advertisement_ms != 1000 %}
 vrrp {{ config.group_number }} timers advertise msec {{ options.advertisement_ms }}
{% endif %}
{% if options.auth_type != 'none' %}
 vrrp {{ config.group_number }} authentication text {{ options.auth_secret }}
{% endif %}
{% if config.shutdown %}
 vrrp {{ config.group_number }} shutdown
{% endif %}
{% for track in config.tracks %}
 vrrp {{ config.group_number }} track {{ track.track_object }} decrement {{ track.decrement_value }}
{% endfor %}
{% else %}
 glbp {{ config.group_number }} ip {{ config.virtual_ip }}
 glbp {{ config.group_number }} priority {{ config.priority }}
{% if config.preempt %}
 glbp {{ config.group_number }} preempt
{% else %}
 no glbp {{ config.group_number }} preempt
{% endif %}
{% if options.hello_ms != 3000 or options.hold_ms != 10000 %}
{% if options.hello_ms % 1000 == 0 and options.hold_ms % 1000 == 0 %}
 glbp {{ config.group_number }} timers {{ options.hello_ms // 1000 }} {{ options.hold_ms // 1000 }}
{% else %}
 glbp {{ config.group_number }} timers msec {{ options.hello_ms }} msec {{ options.hold_ms }}
{% endif %}
{% endif %}
 glbp {{ config.group_number }} load-balancing {{ options.load_balancing }}
 glbp {{ config.group_number }} weighting {{ options.weighting_max }}{% if options.weighting_lower %} lower {{ options.weighting_lower }}{% endif %}{% if options.weighting_upper %} upper {{ options.weighting_upper }}{% endif %}
{% if options.forwarder_preempt %}
 glbp {{ config.group_number }} forwarder preempt
{% if options.forwarder_preempt_delay_sec %}
 glbp {{ config.group_number }} forwarder preempt delay minimum {{ options.forwarder_preempt_delay_sec }}
{% endif %}
{% else %}
 no glbp {{ config.group_number }} forwarder preempt
{% endif %}
{% if options.auth_type == 'plain' %}
 glbp {{ config.group_number }} authentication text {{ options.auth_secret }}
{% elif options.auth_type == 'md5-key' %}
 glbp {{ config.group_number }} authentication md5 key-string {{ options.auth_secret }}
{% elif options.auth_type == 'md5-keychain' %}
 glbp {{ config.group_number }} authentication md5 key-chain {{ options.auth_secret }}
{% endif %}
{% for track in config.tracks %}
 glbp {{ config.group_number }} weighting track {{ track.track_object }} decrement {{ track.decrement_value }}
{% endfor %}
{% if config.shutdown %}
 glbp {{ config.group_number }} shutdown
{% endif %}
{% endif %}
{% endif %}
 exit
