{
  "Cisco-IOS-XE-native:router": {
    "Cisco-IOS-XE-ospf:router-ospf": {
      "ospf": {
        "process-id": [
          {
            "id": {{ config.process_id }}
            
            {% if config.router_id %}
            ,
            "router-id": "{{ config.router_id }}"
            {% endif %}

            {# --- TỐI ƯU HÓA HỆ THỐNG (TUNING) --- #}
            {% if config.tuning %}
              {% if config.tuning.maximum_paths is defined %}
              ,
              "maximum-paths": {{ config.tuning.maximum_paths }}
              {% endif %}
              
              {% if config.tuning.max_lsa is defined %}
              ,
              "max-lsa": {
                "number": {{ config.tuning.max_lsa }}
              }
              {% endif %}

              {% if config.tuning.timers is defined %}
              ,
              "timers": {
                "throttle": {
                  {% if config.tuning.timers.spf is defined %}
                  "spf": {
                    "delay": {{ config.tuning.timers.spf.delay }},
                    "min-delay": {{ config.tuning.timers.spf.min_delay }},
                    "max-delay": {{ config.tuning.timers.spf.max_delay }}
                  }
                  {% endif %}
                  
                  {% if config.tuning.timers.lsa is defined %}
                  {% if config.tuning.timers.spf is defined %},{% endif %}
                  "lsa": {
                    "delay": {{ config.tuning.timers.lsa.delay }},
                    "min-delay": {{ config.tuning.timers.lsa.min_delay }},
                    "max-delay": {{ config.tuning.timers.lsa.max_delay }}
                  }
                  {% endif %}
                }
              }
              {% endif %}
            {% endif %}

            {# --- CẤU HÌNH AREA --- #}
            {% if config.areas and config.areas | length > 0 %}
            {% set ns_area = namespace(has_active=false) %}
            {% for area in config.areas if area.state != 'remove' and area.state != 'absent' %}
              {% set ns_area.has_active = true %}
            {% endfor %}
            
            {% if ns_area.has_active %}
            ,
            "area": [
              {% for area in config.areas if area.state != 'remove' and area.state != 'absent' %}
              {
                "area-id": {{ area.id }}
                
                {% if area.authentication == 'message-digest' %}
                ,
                "authentication": {
                  "message-digest": [null]
                }
                {% endif %}
                
                {% if area.range and area.range.state != 'remove' and area.range.state != 'absent' %}
                ,
                "ipv4-range": {
                  "range": [
                    {
                      "ip": "{{ area.range.ip }}",
                      "mask": "{{ area.range.mask }}"
                    }
                  ]
                }
                {% endif %}
                
                {% if area.type == 'stub' %}
                ,
                "stub": {
                  {% if area.no_summary %}
                  "no-summary": [null]
                  {% endif %}
                }
                {% elif area.type == 'nssa' %}
                ,
                "nssa": {
                  {% if area.no_summary %}
                  "nssa-options": {
                    "no-summary": [null]
                  }
                  {% endif %}
                }
                {% endif %}
              }{{ "," if not loop.last }}
              {% endfor %}
            ]
            {% endif %}
            {% endif %}
            
            {# --- QUẢNG BÁ MẠNG --- #}
            {% if config.networks and config.networks | length > 0 %}
            {% set ns_net = namespace(has_active=false) %}
            {% for net in config.networks if net.state != 'remove' and net.state != 'absent' %}
              {% set ns_net.has_active = true %}
            {% endfor %}
            
            {% if ns_net.has_active %}
            ,
            "network": [
              {% for net in config.networks if net.state != 'remove' and net.state != 'absent' %}
              {
                "ip": "{{ net.ip }}",
                "wildcard": "{{ net.wildcard }}",
                "area": {{ net.area }}
              }{{ "," if not loop.last }}
              {% endfor %}
            ]
            {% endif %}
            {% endif %}

            {% if config.reference_bandwidth %}
            ,
            "auto-cost": {
              "reference-bandwidth": {{ config.reference_bandwidth }}
            }
            {% endif %}
            
            {% if config.passive_default == true %}
            ,
            "passive-interface": {
              "default": true
            }
            {% elif config.passive_default == 'remove' or config.passive_default == false %}
            ,
            "passive-interface": {
              "default": false
            }
            {% elif config.passive_interfaces and config.passive_interfaces | length > 0 %}
            ,
            "passive-interface": {
              "interface": [
                {% set comma = joiner(",") %}
                {% for intf in config.passive_interfaces %}
                  {{ comma() }}"{{ intf.name }}"
                {% endfor %}
              ]
            }
            {% endif %}
          }
        ]
      }
    }
  }
}